# Playwright test runner container with pre-installed browsers
# This container runs E2E and performance tests against the ecopicks service
# It does NOT run the Next.js dev server - tests hit the ecopicks container

# Use official Playwright image with all browsers pre-installed
# Version must match @playwright/test version in package.json
FROM mcr.microsoft.com/playwright:v1.57.0-noble

WORKDIR /app

# Copy only files needed for running tests
# Note: Full source is mounted via volume in docker-compose for live updates
COPY package*.json ./
COPY playwright.config.ts ./
COPY tsconfig.json ./

# Install project dependencies (Playwright is already in the base image)
RUN npm install

# Keep container running for on-demand test execution
# Tests are run via: docker compose exec test-runner sh -c "npm run test:e2e"
CMD ["tail", "-f", "/dev/null"]
