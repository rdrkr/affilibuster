{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post",
    "description": "Blog posts with title, content, featured image, author, tags, and SEO metadata"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "content": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.text-block",
      "repeatable": false,
      "required": true
    },
    "wideImage": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "squareImage": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "author": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::contributor.contributor",
      "pluginOptions": {
        "strapi-plugin-relation-filter": {
          "filters": {
            "roles": {
              "roleId": {
                "$eq": "author"
              }
            }
          }
        }
      },
      "required": true
    },
    "readTimeInMinutes": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "default": 5
    },
    "tags": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-post-tag.blog-post-tag",
      "required": true
    },
    "publishedDate": {
      "type": "datetime",
      "required": true
    },
    "seoMetadata": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.seo-metadata",
      "repeatable": false,
      "required": true
    }
  }
}
