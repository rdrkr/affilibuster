{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post",
    "description": "Blog posts with title, content, featured image, contributor, tags, and SEO metadata"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "content": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.text-block",
      "repeatable": false,
      "required": true
    },
    "featuredImage": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "contributor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::contributor.contributor",
      "inversedBy": "blogPosts"
    },
    "readTimeInMinutes": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "default": 5
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::blog-post-tag.blog-post-tag",
      "mappedBy": "posts"
    },
    "publishedDate": {
      "type": "datetime",
      "required": true
    },
    "seoMetadata": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.seo-metadata",
      "repeatable": false,
      "required": true
    }
  }
}
