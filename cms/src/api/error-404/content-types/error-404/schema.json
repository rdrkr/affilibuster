{
  "kind": "singleType",
  "collectionName": "error_404s",
  "info": {
    "singularName": "error-404",
    "pluralName": "error-404s",
    "displayName": "Error 404",
    "description": "404 Not Found error page with localized title, subtitle, message, primary and secondary CTAs, and SEO metadata"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "entryTitle": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "subtitle": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "message": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ctaText": {
      "type": "string",
      "default": "Go to Homepage",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "secondaryCtaText": {
      "type": "string",
      "default": "Browse Products",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "content": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "metaTitle": {
      "type": "string",
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "metaDescription": {
      "type": "text",
      "maxLength": 160,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
