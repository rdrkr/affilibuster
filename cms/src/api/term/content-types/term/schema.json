{
  "kind": "singleType",
  "collectionName": "terms",
  "info": {
    "singularName": "term",
    "pluralName": "terms",
    "displayName": "Terms of Service Page",
    "description": "Terms of service page with rich text content, last updated timestamp, custom update label, and SEO metadata (title, description, keywords)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "entryTitle": {
      "type": "string",
      "private": true,
      "default": "Terms and Conditions Page",
      "required": true
    },
    "lastUpdated": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "lastUpdatedLabel": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seoMetadata": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.seo-metadata",
      "repeatable": false,
      "required": true
    }
  }
}
