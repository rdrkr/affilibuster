{
  "kind": "singleType",
  "collectionName": "navigation",
  "info": {
    "singularName": "navigation",
    "pluralName": "navigations",
    "displayName": "Navigation",
    "description": "Top menu bar navigation: main menu links, search functionality, theme selector, language selector, and UI labels for the navbar"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "entryTitle": {
      "type": "string",
      "private": true,
      "default": "Navigation",
      "required": true
    },
    "siteTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "TheGreenBrother",
      "maxLength": 60,
      "required": true
    },
    "siteDescription": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "brandButton": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.button",
      "repeatable": false,
      "required": true
    },
    "homeButton": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.button",
      "repeatable": false,
      "required": true
    },
    "productsMenu": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "menus.product-categories-selector",
      "repeatable": false,
      "required": true
    },
    "blogButton": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.button",
      "repeatable": false,
      "required": true
    },
    "aboutButton": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.button",
      "repeatable": false,
      "required": true
    },
    "searchMenu": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "menus.search-menu",
      "repeatable": false,
      "required": true
    },
    "themeMenu": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "menus.theme-selector",
      "repeatable": false,
      "required": true
