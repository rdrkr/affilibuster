{
  "kind": "singleType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog Page",
    "description": "Blog listing page with title, description, category filters, and UI labels"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "entryTitle": {
      "type": "string",
      "private": true,
      "default": "Blog Page",
      "required": true
    },
    "header": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.header",
      "repeatable": false,
      "required": true
    },
    "tagFilters": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-post-tag.blog-post-tag"
    },
    "featuredBlogPosts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-post.blog-post"
    },
    "blogPosts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-post.blog-post"
    },
    "pagination": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "call-to-actions.pagination-cta",
      "repeatable": false,
      "required": true
    },
    "readArticleLabel": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.label",
      "repeatable": false,
      "required": true
    },
    "readTimeMinutesLabel": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.label",
      "repeatable": false,
      "required": true
    },
    "aboutAuthorHeader": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.header",
      "repeatable": false,
      "required": true
    },
    "seoMetadata": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.seo-metadata",
      "repeatable": false,
      "required": true
    }
  }
}
