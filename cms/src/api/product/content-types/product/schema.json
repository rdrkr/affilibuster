{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Affiliate product with multi-language support, pricing in multiple currencies, rich content, featured flag, category tags, translation status, and affiliate tracking URL"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "seller": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::contributor.contributor",
      "pluginOptions": {
        "strapi-plugin-relation-filter": {
          "filters": {
            "roles": {
              "roleId": {
                "$eq": "seller"
              }
            }
          }
        }
      },
      "required": true
    },
    "header": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.header",
      "repeatable": false,
      "required": true
    },
    "images": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "multiple": true,
      "required": true,
      "allowedTypes": ["images"]
    },
    "prices": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "component": "elements.price",
      "repeatable": true,
      "required": true,
      "min": 1
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::product-category.product-category",
      "required": true
    },
    "certificates": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-certificate.product-certificate"
    },
    "tags": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product-tag.product-tag"
    },
    "affiliateButton": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.button",
      "repeatable": false,
      "required": true
    },
    "disclaimerLabel": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.label",
      "repeatable": false,
      "required": true
    },
    "viewDetailsLabel": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.label",
      "repeatable": false,
      "required": true
    },
    "description": {
      "type": "dynamiczone",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "components": [
        "elements.text-block",
        "markers.start-horizontal-layout-marker",
        "markers.end-horizontal-layout-marker"
      ],
      "required": true
    },
    "seoMetadata": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "elements.seo-metadata",
      "repeatable": false,
      "required": true
    }
  }
}
