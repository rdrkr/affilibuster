FROM node:22-alpine

WORKDIR /app

# Install curl for health checks and postgresql-client for database queries
RUN apk add --no-cache curl postgresql-client python3 make g++

# Copy package files first for layer caching
COPY package.json package-lock.json* ./

# Copy plugin package files for workspace resolution
COPY src/plugins/strapi-plugin-relation-filter/package.json \
     src/plugins/strapi-plugin-relation-filter/package.json

# Install all dependencies
RUN npm ci

# Copy application source
COPY . .

# Build args needed for strapi build (config/server.ts reads these)
ARG CMS_PORT=1337
ARG CMS_HOST=localhost
ARG CMS_PROTOCOL=http
ARG APP_KEYS=build-time-placeholder-key

# Set as ENV for the build step
ENV CMS_PORT=${CMS_PORT}
ENV CMS_HOST=${CMS_HOST}
ENV CMS_PROTOCOL=${CMS_PROTOCOL}
ENV APP_KEYS=${APP_KEYS}
ENV NODE_ENV=production

# Build workspace plugins and Strapi admin panel
RUN npm run build:plugins && npx strapi build

# Remove dev dependencies after build to reduce image size
RUN npm prune --production

# Non-root user for security
RUN addgroup -g 1001 strapi && \
    adduser -u 1001 -G strapi -s /bin/sh -D strapi && \
    chown -R strapi:strapi /app

USER strapi

EXPOSE ${CMS_PORT}

# Start Strapi production server
CMD ["npm", "run", "start"]
