{
  "name": "affilibuster-cms",
  "version": "0.1.0",
  "private": true,
  "description": "Affiliate platform CMS",
  "scripts": {
    "strapi": "strapi",
    "openapi:generate": "mkdir -p public/uploads && strapi openapi generate --output ../contracts/strapi.openapi.yaml && npx tsx ./scripts/merge-openapi.ts && npx @redocly/cli lint ../contracts/strapi.openapi.yaml && npx @redocly/cli lint ../contracts/affilibuster.openapi.yaml",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 . && npm run type-check",
    "lint:fix": "eslint --fix --max-warnings 0 . && npm run type-check",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "preflight": "strapi ts:generate-types && npm run openapi:generate && npm run format:fix && npm run lint:fix",
    "dev": "npm run preflight && strapi develop",
    "develop": "npm run dev",
    "prebuild": "npm run preflight",
    "build": "strapi build",
    "clean": "rm -rf coverage node_modules build .tmp .strapi dist",
    "start": "strapi start",
    "data:export": "mkdir -p ../data; rm -rf ../data/assets ../data/entities ../data/schemas ../data/configuration ../data/links ../data/metadata.json || true; npm run strapi export -- --no-encrypt --no-compress -f ../data/export; tar -xf ../data/export.tar -C ../data; rm -f ../data/export.tar || true; sed -i '/\"type\":\"api::api-config.api-config\"/d' ../data/entities/entities_*.jsonl",
    "data:import": "strapi import"
  },
  "dependencies": {
    "@encoreskytech/strapi-plugin-nested-populator": "^1.3.0",
    "@eslint/js": "^9.39.2",
    "@redocly/cli": "^2.12.7",
    "@strapi/provider-upload-cloudinary": "^5.32.0",
    "@strapi/strapi": "^5.32.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.1",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^61.5.0",
    "jiti": "^2.6.1",
    "js-yaml": "^4.1.1",
    "lint-staged": "^16.2.7",
    "pg": "^8.16.3",
    "prettier": "^3.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.2",
    "styled-components": "^6.1.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "overrides": {
    "zod": "3.26.0-canary.20250708T225111"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,scss,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "strapi": {
    "uuid": "f7dd1be1-42f2-4868-a3da-645d455df353"
  },
  "engines": {
    "node": ">=20.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  }
}
