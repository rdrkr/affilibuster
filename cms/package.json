{
  "name": "affilibuster-cms",
  "version": "0.1.0",
  "private": true,
  "description": "Affiliate platform CMS",
  "scripts": {
    "develop": "strapi develop",
    "start": "strapi start",
    "build": "strapi build",
    "strapi": "strapi",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:generate": "strapi openapi generate --output ../contracts/strapi.openapi.yaml"
  },
  "dependencies": {
    "@strapi/strapi": "^5.28.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "styled-components": "^6.1.15",
    "zod": "3.26.0-canary.20250708T225111"
  },
  "overrides": {
    "zod": "3.26.0-canary.20250708T225111"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@redocly/cli": "^2.8.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.7.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.8",
    "jiti": "^2.6.1",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "tsx": "^4.7.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.46.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,scss,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "strapi": {
    "uuid": "00000000-0000-0000-0000-000000000000"
  },
  "engines": {
    "node": ">=20.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  }
}
