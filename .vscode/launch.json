{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TheGreenBrother: Debug Server-Side",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/the-green-brother",
      "presentation": {
        "group": "the-green-brother",
        "order": 1
      }
    },
    {
      "name": "TheGreenBrother: Debug Client-Side",
      "type": "chrome",
      "request": "launch",
      "url": "https://localhost:3000/en/blog",
      "webRoot": "${workspaceFolder}/the-green-brother",
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${webRoot}/*",
        "/app/*": "${webRoot}/*",
        "file:///app/*": "${webRoot}/*"
      },
      "presentation": {
        "group": "the-green-brother",
        "order": 2
      }
    },
    {
      "name": "TheGreenBrother: Debug Full Stack",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/the-green-brother",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      },
      "presentation": {
        "group": "the-green-brother",
        "order": 3
      }
    },
    {
      "name": "Backend: Debug FastAPI Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["affilibuster_backend.main:app", "--reload", "--port", "8000", "--host", "0.0.0.0"],
      "cwd": "${workspaceFolder}/backend/src",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend/src"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": {
        "group": "backend",
        "order": 1
      }
    },
    {
      "name": "Backend: Debug Current Test File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v", "--no-cov"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": {
        "group": "backend",
        "order": 2
      }
    },
    {
      "name": "Backend: Debug All Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-v", "--no-cov"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": {
        "group": "backend",
        "order": 3
      }
    },
    {
      "name": "CMS: Debug Strapi Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run develop",
      "cwd": "${workspaceFolder}/cms",
      "presentation": {
        "group": "cms",
        "order": 1
      }
    },
    {
      "name": "CMS: Debug Strapi Build",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run build",
      "cwd": "${workspaceFolder}/cms",
      "presentation": {
        "group": "cms",
        "order": 2
      }
    },
    {
      "name": "TheGreenBrother: Debug Jest Tests",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test", "--", "--runInBand", "--no-coverage"],
      "cwd": "${workspaceFolder}/the-green-brother",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "presentation": {
        "group": "the-green-brother-tests",
        "order": 1
      }
    },
    {
      "name": "TheGreenBrother: Debug Current Jest Test",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/the-green-brother/node_modules/.bin/jest",
      "args": ["${fileBasenameNoExtension}", "--runInBand", "--no-coverage"],
      "cwd": "${workspaceFolder}/the-green-brother",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "presentation": {
        "group": "the-green-brother-tests",
        "order": 2
      }
    },
    {
      "name": "TheGreenBrother: Debug Playwright Tests",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test:e2e", "--", "--headed"],
      "cwd": "${workspaceFolder}/the-green-brother",
      "console": "integratedTerminal",
      "presentation": {
        "group": "the-green-brother-tests",
        "order": 3
      }
    },
    {
      "name": "Full Stack: Debug All Services",
      "type": "node-terminal",
      "request": "launch",
      "command": "make dev",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "fullstack",
        "order": 1
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: TheGreenBrother + Backend",
      "configurations": ["TheGreenBrother: Debug Server-Side", "Backend: Debug FastAPI Server"],
      "presentation": {
        "group": "compounds",
        "order": 1
      }
    },
    {
      "name": "Full Stack: All Services (TheGreenBrother + Backend + CMS)",
      "configurations": [
        "TheGreenBrother: Debug Server-Side",
        "Backend: Debug FastAPI Server",
        "CMS: Debug Strapi Server"
      ],
      "presentation": {
        "group": "compounds",
        "order": 2
      }
    }
  ]
}
