    },
    {
      "label": "tools: Prettier CMS",
      "type": "shell",
      "command": "cd cms && npx prettier --write .",
      "problemMatcher": []
    },
    {
      "label": "db: Run Migrations (Upgrade Head)",
      "type": "shell",
      "command": "cd backend && uv run alembic upgrade head",
      "problemMatcher": []
    },
    {
      "label": "db: Downgrade One Migration",
      "type": "shell",
      "command": "cd backend && uv run alembic downgrade -1",
      "problemMatcher": []
    },
    {
      "label": "db: Show Current Revision",
      "type": "shell",
      "command": "cd backend && uv run alembic current",
      "problemMatcher": []
    },
    {
      "label": "db: Show Migration History",
      "type": "shell",
      "command": "cd backend && uv run alembic history",
      "problemMatcher": []
    },
    {
      "label": "db: Create New Migration",
      "type": "shell",
      "command": "cd backend && uv run alembic revision --autogenerate -m \"${input:migrationMessage}\"",
      "problemMatcher": []
    }
