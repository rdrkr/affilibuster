      "command": "cd backend && uv run task openapi-generate",
      "problemMatcher": []
    },
    {
      "label": "backend: Clean",
      "type": "shell",
      "command": "cd backend && uv run task clean",
      "problemMatcher": []
    },
    {
      "label": "tools: Ruff Check",
      "type": "shell",
      "command": "cd backend && uv run ruff check .",
      "problemMatcher": {
        "owner": "ruff",
        "pattern": [
          {
            "regexp": "^(.+):(\\d+):(\\d+):\\s+(E|W|F)(\\d+)\\s+(.+)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "code": 5,
            "message": 6
          }
        ]
      }
    },
    {
      "label": "tools: Ruff Fix",
      "type": "shell",
      "command": "cd backend && uv run ruff check . --fix",
      "problemMatcher": []
    },
    {
      "label": "tools: Ruff Format",
      "type": "shell",
      "command": "cd backend && uv run ruff format .",
      "problemMatcher": []
    },
    {
      "label": "tools: Mypy",
      "type": "shell",
      "command": "cd backend && uv run mypy src",
      "problemMatcher": {
        "owner": "mypy",
        "pattern": [
          {
            "regexp": "^(.+):(\\d+):\\s+(error|warning|note):\\s+(.+)$",
            "file": 1,
            "line": 2,
            "severity": 3,
            "message": 4
          }
        ]
      }
    },
    {
      "label": "tools: Pytest",
      "type": "shell",
      "command": "cd backend && uv run pytest",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "tools: ESLint Frontend",
      "type": "shell",
      "command": "cd frontend && npx eslint .",
      "problemMatcher": "$eslint-compact"
    },
    {
      "label": "tools: ESLint Frontend Fix",
      "type": "shell",
      "command": "cd frontend && npx eslint . --fix",
      "problemMatcher": "$eslint-compact"
    },
