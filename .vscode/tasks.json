      "label": "backend: Start Server",
      "type": "shell",
      "command": "cd backend && uv run task start",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "backend: Lint (Ruff + Mypy)",
      "type": "shell",
      "command": "cd backend && uv run task lint",
      "problemMatcher": [
        {
          "owner": "ruff",
          "pattern": [
            {
              "regexp": "^(.+):(\\d+):(\\d+):\\s+(E|W|F)(\\d+)\\s+(.+)$",
              "file": 1,
              "line": 2,
              "column": 3,
              "severity": 4,
              "code": 5,
              "message": 6
            }
          ]
        },
        {
          "owner": "mypy",
          "pattern": [
            {
              "regexp": "^(.+):(\\d+):\\s+(error|warning|note):\\s+(.+)$",
              "file": 1,
              "line": 2,
              "severity": 3,
              "message": 4
            }
          ]
        }
      ]
    },
