{
  "name": "affilibuster-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "openapi:generate": "openapi-ts",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix --max-warnings 0 .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "type-check": "tsc --noEmit -p tsconfig.lint.json",
    "preflight": "npm run openapi:generate && npm run format:fix && npm run lint:fix && npm run type-check",
    "dev": "npm run preflight && next dev",
    "develop": "npm run dev",
    "prebuild": "npm run preflight",
    "build": "next build",
    "clean": "rm -rf coverage node_modules .next test-results tsconfig.tsbuildinfo next-env.d.ts .swc playwright-report src/lib/generated",
    "prestart": "npm run build",
    "start": "next start",
    "test": "jest --coverage --coverageReporters=text --coverageReporters=text-summary --coverageReporters=lcov --coverageReporters=html",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next-intl": "^4.3.12",
    "next-seo": "^6.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.38.0",
    "@hey-api/openapi-ts": "^0.86.12",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.3",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15.2.10",
    "next": "^16.0.1",
    "postcss": "^8.5.6",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.46.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,scss,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
