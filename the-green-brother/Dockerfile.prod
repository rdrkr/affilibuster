# ============================================
# Stage 1: Dependencies - Install node_modules
# ============================================
FROM node:22-slim AS deps

WORKDIR /app

# Copy package files first for layer caching
COPY package.json package-lock.json* ./

# Install all dependencies (including dev for build)
RUN npm ci

# ============================================
# Stage 2: Builder - Build Next.js application
# ============================================
FROM node:22-slim AS builder

# Mirror monorepo layout so tsconfig relative paths resolve correctly:
# tsconfig paths use "../frontend/" which must resolve to a sibling directory
WORKDIR /repo/the-green-brother

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json

# Copy application source (includes committed generated types)
COPY . .

# Copy shared frontend package as sibling (mirrors local monorepo layout)
COPY --from=frontend . /repo/frontend/
RUN if [ -d "node_modules/@affilibuster/frontend" ]; then rm -rf node_modules/@affilibuster/frontend; fi && \
    ln -sfn /repo/frontend node_modules/@affilibuster/frontend && \
    ln -sfn /repo/frontend /repo/the-green-brother/frontend

# Build-time env vars needed for Next.js static optimization
# NEXT_PUBLIC_* are baked into the client bundle at build time
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_CMS_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_GA_ID
ARG NEXT_PUBLIC_GTM_ID
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_CMS_URL=${NEXT_PUBLIC_CMS_URL}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_GA_ID=${NEXT_PUBLIC_GA_ID}
ENV NEXT_PUBLIC_GTM_ID=${NEXT_PUBLIC_GTM_ID}

# Build-time env vars for next.config.ts remotePatterns (image domains)
ARG BACKEND_PROTOCOL=https
ARG BACKEND_HOST=thegreenbrother.com
ARG BACKEND_PORT=443
ARG CMS_PROTOCOL=https
ARG CMS_HOST=cms.thegreenbrother.com
ARG CMS_PORT=443
ENV BACKEND_PROTOCOL=${BACKEND_PROTOCOL}
ENV BACKEND_HOST=${BACKEND_HOST}
ENV BACKEND_PORT=${BACKEND_PORT}
ENV CMS_PROTOCOL=${CMS_PROTOCOL}
ENV CMS_HOST=${CMS_HOST}
ENV CMS_PORT=${CMS_PORT}

# Build Next.js (skip preflight - generated types are already committed)
# next.config.ts has output: 'standalone' for self-contained production server
RUN npx next build

# ============================================
# Stage 3: Runtime - Lean production image
# ============================================
FROM node:22-slim AS runtime

WORKDIR /app

# Install runtime dependencies only
RUN apt-get update && apt-get install -y \
  curl \
  && rm -rf /var/lib/apt/lists/*

# Copy Next.js standalone output and static files
# outputFileTracingRoot nests output under the project name, so copy from the nested path
COPY --from=builder /repo/the-green-brother/.next/standalone/the-green-brother ./
COPY --from=builder /repo/the-green-brother/.next/static ./.next/static
COPY --from=builder /repo/the-green-brother/public ./public

# Non-root user for security
RUN groupadd -g 1001 nextjs && \
  useradd -u 1001 -g nextjs -s /bin/sh -m nextjs && \
  chown -R nextjs:nextjs /app

USER nextjs

ARG THE_GREEN_BROTHER_PORT=3000
ENV PORT=${THE_GREEN_BROTHER_PORT}
ENV HOSTNAME="0.0.0.0"
ENV NODE_ENV=production

EXPOSE ${THE_GREEN_BROTHER_PORT}

# Next.js standalone server (no custom server.ts - Caddy handles SSL)
CMD ["node", "server.js"]
