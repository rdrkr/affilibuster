{
  "name": "the-green-brother",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "openapi:generate": "openapi-ts",
    "type-check": "tsc --noEmit -p tsconfig.lint.json",
    "lint": "eslint --max-warnings 0 . && npm run type-check",
    "lint:fix": "eslint --fix --max-warnings 0 . && npm run type-check",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "preflight": "npm run openapi:generate && npm run format:fix && npm run lint:fix",
    "dev": "npm run preflight && tsx server.ts",
    "develop": "npm run dev",
    "prebuild": "npm run preflight",
    "build": "next build",
    "clean": "rm -rf coverage node_modules .next test-results core tsconfig.tsbuildinfo next-env.d.ts .swc playwright-report ../.coverage ../test-results",
    "start": "next start",
    "test": "jest --coverage --coverageReporters=lcov --coverageReporters=html --passWithNoTests",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.2",
    "@hey-api/openapi-ts": "^0.89.1",
    "@material-symbols/font-400": "^0.40.2",
    "@material-symbols/font-700": "^0.40.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "baseline-browser-mapping": "^2.9.10",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^3.8.0",
    "eslint-plugin-jsdoc": "^61.5.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "next": "^16.1.0",
    "next-intl": "^4.6.1",
    "next-seo": "^7.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "uuid": "^13.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,scss,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
