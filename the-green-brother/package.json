{
  "name": "the-green-brother",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "openapi:generate": "openapi-ts",
    "type-check": "tsc --noEmit -p tsconfig.lint.json",
    "lint": "eslint --max-warnings 0 . && npm run type-check",
    "lint:fix": "eslint --fix --max-warnings 0 . && npm run type-check",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "preflight": "npm run openapi:generate && npm run format:fix && npm run lint:fix",
    "warm-cache": "tsx scripts/warm-cache.ts",
    "dev": "npm run preflight && (tsx server.ts & npm run warm-cache; wait)",
    "develop": "npm run dev",
    "prebuild": "npm run preflight",
    "build": "next build",
    "clean": "rm -rf coverage node_modules .next test-results core tsconfig.tsbuildinfo next-env.d.ts .swc playwright-report ../.coverage ../test-results",
    "start": "next start",
    "test": "jest --coverage --coverageReporters=lcov --coverageReporters=html --passWithNoTests",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.2",
    "@hey-api/openapi-ts": "^0.90.10",
    "@material-symbols/font-400": "^0.40.2",
    "@material-symbols/font-700": "^0.40.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "25.0.8",
    "@types/react": "19.2.8",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.3.1",
    "eslint-plugin-jsdoc": "^62.7.1",
    "flags": "^4.0.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jiti": "^2.6.1",
    "lint-staged": "^16.2.7",
    "next": "^16.1.6",
    "next-intl": "^4.8.3",
    "next-seo": "^7.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "uuid": "^13.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,scss,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
