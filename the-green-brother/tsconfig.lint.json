{
  "extends": "@affilibuster/frontend/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/types/*": ["./src/types/*"],
      "@affilibuster/frontend": ["../frontend/src/index.ts"],
      "@affilibuster/frontend/generated/*": ["../frontend/src/lib/generated/*"],
      "@affilibuster/frontend/*": ["../frontend/src/*"]
    }
  },
  "include": [
    "*.ts",
    "*.tsx",
    "*.mjs",
    "*.mts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mjs",
    "src/**/*.mts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "../data/**/*.json"
  ],
  "exclude": [
    "node_modules",
    ".next/**",
    "**/.next/**",
    "next-env.d.ts",
    "out",
    "dist",
    "build",
    ".turbo",
    "package-lock.json",
    "eslint.config.mts"
  ]
}
