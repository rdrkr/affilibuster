# Affilibuster Environment Configuration - PRODUCTION (Hetzner VPS)
# ==================================================================
#
# SETUP INSTRUCTIONS:
# -------------------
# 1. Copy this file on the VPS: cp .env.prod.example .env.prod
# 2. Fill in all secrets with strong, randomly-generated values
# 3. Extract current Render secrets and use the SAME values for:
#    - ADMIN_JWT_SECRET, API_TOKEN_SALT, API_TOKEN_ENCRYPTION_KEY
#    - TRANSFER_TOKEN_SALT, APP_KEYS, JWT_SECRET, REVALIDATE_SECRET
#    These MUST match to keep existing API tokens and sessions valid.
#
# ARCHITECTURE:
# - Caddy handles SSL termination at the edge (ports 80/443)
# - All inter-service communication is plain HTTP inside Docker
# - No SSL certificates needed on individual services
#
# IMPORTANT SECURITY NOTES:
# -------------------------
# NEVER commit .env.prod file to version control
# Change all secrets (JWT keys, API tokens) in production
# Use strong, randomly-generated values for all *_SECRET variables
# Generate secrets with: openssl rand -base64 32

# ======================================
# SHARED INFRASTRUCTURE
# ======================================

# PostgreSQL Database (internal Docker, no SSL needed)
POSTGRES_PROTOCOL=postgresql
POSTGRES_HOST=localhost
INTERNAL_POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=affilibuster
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=affilibuster_db
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true

# Redis Cache & Session Store (internal Docker)
REDIS_PROTOCOL=redis
REDIS_HOST=localhost
INTERNAL_REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL_PREFERENCES=2592000  # 30 days in seconds

# ======================================
# CMS (Strapi 5 - Node.js)
# ======================================
# Caddy handles HTTPS. Strapi runs on plain HTTP internally.
# No strapi-proxy (Nginx) needed -- Caddy replaces it.

# Server Configuration
# CMS_PROTOCOL=https for public-facing URLs (next.config.ts image remotePatterns)
# Backend overrides CMS_PROTOCOL to http in docker-compose.prod.yaml for internal communication
CMS_PROTOCOL=https
CMS_PORT=443
CMS_HOST=cms.thegreenbrother.com
INTERNAL_CMS_HOST=strapi

# SSL paths not needed (Caddy handles SSL)
SSL_CERT_PATH=
SSL_KEY_PATH=

# CMS URLs
CMS_URL_PROD=https://cms.thegreenbrother.com
CMS_URL_DEV=https://cms.thegreenbrother.com

# Cloudinary (extract from Render dashboard)
CLOUDINARY_NAME=CHANGE_ME_EXTRACT_FROM_RENDER
CLOUDINARY_KEY=CHANGE_ME_EXTRACT_FROM_RENDER
CLOUDINARY_SECRET=CHANGE_ME_EXTRACT_FROM_RENDER

# Security Keys (MUST match current Render values to keep tokens valid)
ADMIN_JWT_SECRET=CHANGE_ME_EXTRACT_FROM_RENDER
API_TOKEN_SALT=CHANGE_ME_EXTRACT_FROM_RENDER
API_TOKEN_ENCRYPTION_KEY=CHANGE_ME_EXTRACT_FROM_RENDER
TRANSFER_TOKEN_SALT=CHANGE_ME_EXTRACT_FROM_RENDER
APP_KEYS=CHANGE_ME_EXTRACT_FROM_RENDER

# Preview (Draft Mode)
# Generate with: openssl rand -base64 32
PREVIEW_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
# Frontend URL for preview redirect (CMS → TheGreenBrother)
CLIENT_URL=https://your-production-domain.com

# ======================================
# BACKEND (FastAPI - Python 3.13)
# ======================================

# Application Configuration
APP_ENV=production
DEBUG=false
LOG_LEVEL=WARNING

# Server Configuration
# BACKEND_PROTOCOL=https enables Secure cookie flag (browser connects via HTTPS through Caddy)
# The backend itself runs on HTTP internally; Caddy handles SSL termination
BACKEND_PROTOCOL=https
BACKEND_PORT=8000
BACKEND_HOST=thegreenbrother.com
INTERNAL_BACKEND_HOST=backend

# Backend URLs
BACKEND_URL_PROD=https://thegreenbrother.com/api/v1
BACKEND_URL_DEV=https://thegreenbrother.com/api/v1

# Security (MUST match current Render value)
JWT_SECRET=CHANGE_ME_EXTRACT_FROM_RENDER

# ======================================
# THE_GREEN_BROTHER (Next.js 16 - TypeScript)
# ======================================

# Environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# TheGreenBrother Configuration
# Protocol/host are public-facing values (used by next.config.ts remotePatterns)
# The frontend runs on HTTP internally; Caddy handles SSL termination
THE_GREEN_BROTHER_PROTOCOL=https
THE_GREEN_BROTHER_PORT=3000
THE_GREEN_BROTHER_HOST=thegreenbrother.com
INTERNAL_THE_GREEN_BROTHER_HOST=the-green-brother

# Public URLs (browser-accessible via Caddy, baked into client bundle at build time)
NEXT_PUBLIC_API_URL=https://thegreenbrother.com/api/v1
NEXT_PUBLIC_CMS_URL=https://cms.thegreenbrother.com
NEXT_PUBLIC_SITE_URL=https://thegreenbrother.com

# Server-side API URL (internal Docker network, bypasses Caddy for SSR)
NEXT_SERVER_SIDE_API_URL=http://backend:8000/v1

# Revalidation secret for ISR (MUST match current Render value)
REVALIDATE_SECRET=CHANGE_ME_EXTRACT_FROM_RENDER

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# ======================================
# UPTIME KUMA (Monitoring)
# ======================================
UPTIME_KUMA_URL=http://uptime-kuma:3001
UPTIME_KUMA_USER=CHANGE_ME_STRONG_USER
UPTIME_KUMA_PASS=CHANGE_ME_STRONG_PASSWORD
UPTIME_KUMA_TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN
UPTIME_KUMA_TELEGRAM_CHAT_ID=CHANGE_ME_CHAT_ID
