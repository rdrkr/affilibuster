# Affilibuster Environment Configuration
# =======================================
#
# SETUP INSTRUCTIONS:
# -------------------
# 1. Copy this file: cp .env.dev.example .env
# 2. Customize values for your environment
# 3. For Docker: Use Docker networking hostnames (postgres, redis, strapi)
# 4. For Local Development: Use localhost for all services
#
# IMPORTANT SECURITY NOTES:
# -------------------------
# ⚠️  NEVER commit .env file to version control
# ⚠️  Change all secrets (JWT keys, API tokens) in production
# ⚠️  Use strong, randomly-generated values for all *_SECRET variables
# ⚠️  Generate secrets with: openssl rand -base64 32
#
# USAGE IN COMPONENTS:
# --------------------
# Backend: Loads from root .env via docker-compose.yaml
# Frontend: Copy NEXT_PUBLIC_* variables to frontend/.env.local
# CMS: Copy Strapi-specific variables to cms/.env

# ======================================
# SHARED INFRASTRUCTURE
# ======================================
# PostgreSQL and Redis configuration shared across all services

# PostgreSQL Database
POSTGRES_PROTOCOL=postgresql
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=affilibuster
POSTGRES_PASSWORD=affilibuster
POSTGRES_BACKEND_NAME=affilibuster_db_backend
POSTGRES_CMS_NAME=affilibuster_db_cms
POSTGRES_SSL=true
POSTGRES_SSL_REJECT_UNAUTHORIZED=true

# Redis Cache & Session Store
REDIS_PROTOCOL=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL_PREFERENCES=2592000  # 30 days in seconds (prefs: user language/currency)

# ======================================
# CMS (Strapi 5 - Node.js)
# ======================================
# NOTE: Copy these variables to cms/.env

# Server Configuration
CMS_PROTOCOL=https
CMS_PORT=1337
CMS_HOST=cms.affilibuster.com

# CMS URLs for documentation (used by merge-openapi.ts)
CMS_URL_PROD=https://cms.affilibuster.com:1337
CMS_URL_DEV=http://localhost:1337

# Security Keys
# IMPORTANT: Generate new keys for production with: openssl rand -base64 32
STRAPI_API_TOKEN=your-strapi-api-token
ADMIN_JWT_SECRET=your-admin-jwt-secret-change-in-production
API_TOKEN_SALT=your-api-token-salt-change-in-production
TRANSFER_TOKEN_SALT=your-transfer-token-salt-change-in-production
APP_KEYS=your-app-key-1,your-app-key-2,your-app-key-3,your-app-key-4

# ======================================
# BACKEND (FastAPI - Python 3.13)
# ======================================

# Application Configuration
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Server Configuration
BACKEND_PROTOCOL=https
BACKEND_HOST=api.affilibuster.com
BACKEND_PORT=8000

# Backend URLs for documentation (used by merge-openapi.ts)
BACKEND_URL_PROD=https://api.affilibuster.com:8000/v1
BACKEND_URL_DEV=http://localhost:8000/v1

# Security
JWT_SECRET=your-secret-key-change-in-production

# External Services
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest

# ======================================
# FRONTEND (Next.js 15 - TypeScript)
# ======================================
# NOTE: Copy NEXT_PUBLIC_* variables to frontend/.env.local

# Environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Frontend Configuration
FRONTEND_PROTOCOL=https
FRONTEND_PORT=3000
FRONTEND_HOST=affilibuster.com

# Security
REVALIDATE_SECRET=your-revalidation-secret-change-in-production

# Analytics (optional - comment out if not used)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
